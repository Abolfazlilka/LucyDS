class Stack
    def initialize()
        self.items = []
    end
    def push(value)
        self.items.push(value)
        return self.items.length()
    end
    def pop()
        return self.items.pop()
    end
    def peek()
        return self.items.last()
    end
    def size()
        return self.items.length()
    end
    def is_empty()
        return self.items.length() == 0
    end
    def clear()
        self.items.clear()
        return self
    end
    def to_array()
        result = []
        for value in self.items
            result.push(value)
        end
        return result
    end
end
