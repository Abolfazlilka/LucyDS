class TrieNode
    def initialize()
        self.children = {}
        self.terminal = false
    end
end

class Trie
    def initialize()
        self.root = TrieNode.new()
        self.count = 0
    end
    def insert(word)
        current = self.root
        i = 0
        while i < word.length()
            character = word.char_at(i)
            if !current.children.has(character)
                current.children.set(character, TrieNode.new())
            end
            current = current.children.get(character)
            i += 1
        end
        if current.terminal
            return false
        end
        current.terminal = true
        self.count += 1
        return true
    end
    def contains(word)
        node = self._find(word)
        if node == nil
            return false
        end
        return node.terminal
    end
    def starts_with(prefix)
        return self._find(prefix) != nil
    end
    def _find(text)
        current = self.root
        i = 0
        while i < text.length()
            character = text.char_at(i)
            if !current.children.has(character)
                return nil
            end
            current = current.children.get(character)
            i += 1
        end
        return current
    end
    def size()
        return self.count
    end
    def is_empty()
        return self.count == 0
    end
end
