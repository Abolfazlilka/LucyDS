class Deque
    def initialize()
        self.items = []
    end
    def push_front(value)
        self.items.unshift(value)
        return self.items.length()
    end
    def push_back(value)
        self.items.push(value)
        return self.items.length()
    end
    def pop_front()
        return self.items.shift()
    end
    def pop_back()
        return self.items.pop()
    end
    def front()
        return self.items.first()
    end
    def back()
        return self.items.last()
    end
    def size()
        return self.items.length()
    end
    def is_empty()
        return self.items.length() == 0
    end
    def clear()
        self.items.clear()
        return self
    end
    def to_array()
        result = []
        for value in self.items
            result.push(value)
        end
        return result
    end
end
