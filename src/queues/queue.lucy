class Queue
    def initialize()
        self.items = []
        self.front_index = 0
    end
    def enqueue(value)
        self.items.push(value)
        return self.items.length() - self.front_index
    end
    def dequeue()
        if self.is_empty()
            return nil
        end
        value = self.items[self.front_index]
        self.front_index += 1
        if self.front_index >= 32 and self.front_index * 2 >= self.items.length()
            remaining = []
            i = self.front_index
            while i < self.items.length()
                remaining.push(self.items[i])
                i += 1
            end
            self.items = remaining
            self.front_index = 0
        end
        return value
    end
    def peek()
        if self.is_empty()
            return nil
        end
        return self.items[self.front_index]
    end
    def size()
        return self.items.length() - self.front_index
    end
    def is_empty()
        return self.front_index >= self.items.length()
    end
    def clear()
        self.items = []
        self.front_index = 0
        return self
    end
    def to_array()
        result = []
        i = self.front_index
        while i < self.items.length()
            result.push(self.items[i])
            i += 1
        end
        return result
    end
end
