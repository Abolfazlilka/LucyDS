# Disjoint Set Union (Union-Find). Elements are string identifiers.
class UnionFind
    def initialize()
        self.parent = {}
        self.rank = {}
        self.count = 0
    end
    def add(value)
        if type(value) != "string" or self.parent.has(value)
            return false
        end
        self.parent.set(value, value)
        self.rank.set(value, 0)
        self.count += 1
        return true
    end
    def find(value)
        if !self.parent.has(value)
            return nil
        end
        parent_value = self.parent.get(value)
        if parent_value != value
            parent_value = self.find(parent_value)
            self.parent.set(value, parent_value)
        end
        return parent_value
    end
    def union(first, second)
        root_a = self.find(first)
        root_b = self.find(second)
        if root_a == nil or root_b == nil
            return false
        end
        if root_a == root_b
            return false
        end
        rank_a = self.rank.get(root_a)
        rank_b = self.rank.get(root_b)
        if rank_a < rank_b
            self.parent.set(root_a, root_b)
        else if rank_a > rank_b
            self.parent.set(root_b, root_a)
        else
            self.parent.set(root_b, root_a)
            self.rank.set(root_a, rank_a + 1)
        end
        self.count -= 1
        return true
    end
    def connected(first, second)
        root_a = self.find(first)
        root_b = self.find(second)
        if root_a == nil or root_b == nil
            return false
        end
        return root_a == root_b
    end
    def components()
        return self.count
    end
    def size()
        return self.parent.keys().length()
    end
end
