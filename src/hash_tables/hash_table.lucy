# Separate-chaining hash table for string keys.
# Lucy 1.0 maps only support string keys. The educational hash function uses
# the sum of character code-independent positions: length modulo capacity.
# Collisions are handled correctly by bucket chains; this hash is intentionally
# simple and is not intended for adversarial or production workloads.
class HashTableEntry
    def initialize(key, value)
        self.key = key
        self.value = value
    end
end

class HashTable
    def initialize(capacity = 17)
        if capacity < 1
            capacity = 17
        end
        self.capacity = capacity
        self.buckets = []
        i = 0
        while i < capacity
            self.buckets.push([])
            i += 1
        end
        self.count = 0
    end
    def _bucket_index(key)
        return key.length() % self.capacity
    end
    def set(key, value)
        if type(key) != "string"
            return false
        end
        index = self._bucket_index(key)
        bucket = self.buckets[index]
        for entry in bucket
            if entry.key == key
                entry.value = value
                return true
            end
        end
        bucket.push(HashTableEntry.new(key, value))
        self.count += 1
        if self.count > self.capacity * 3
            self._resize(self.capacity * 2 + 1)
        end
        return true
    end
    def get(key)
        if type(key) != "string"
            return nil
        end
        bucket = self.buckets[self._bucket_index(key)]
        for entry in bucket
            if entry.key == key
                return entry.value
            end
        end
        return nil
    end
    def has(key)
        if type(key) != "string"
            return false
        end
        bucket = self.buckets[self._bucket_index(key)]
        for entry in bucket
            if entry.key == key
                return true
            end
        end
        return false
    end
    def delete(key)
        if type(key) != "string"
            return false
        end
        index = self._bucket_index(key)
        bucket = self.buckets[index]
        i = 0
        while i < bucket.length()
            if bucket[i].key == key
                bucket.remove_at(i)
                self.count -= 1
                return true
            end
            i += 1
        end
        return false
    end
    def _resize(new_capacity)
        old_buckets = self.buckets
        self.capacity = new_capacity
        self.buckets = []
        i = 0
        while i < new_capacity
            self.buckets.push([])
            i += 1
        end
        old_count = self.count
        self.count = 0
        for bucket in old_buckets
            for entry in bucket
                index = self._bucket_index(entry.key)
                self.buckets[index].push(entry)
                self.count += 1
            end
        end
        return self.count == old_count
    end
    def keys()
        result = []
        for bucket in self.buckets
            for entry in bucket
                result.push(entry.key)
            end
        end
        return result
    end
    def values()
        result = []
        for bucket in self.buckets
            for entry in bucket
                result.push(entry.value)
            end
        end
        return result
    end
    def size()
        return self.count
    end
    def is_empty()
        return self.count == 0
    end
    def load_factor()
        return self.count / self.capacity
    end
    def clear()
        self.buckets = []
        i = 0
        while i < self.capacity
            self.buckets.push([])
            i += 1
        end
        self.count = 0
        return self
    end
end
